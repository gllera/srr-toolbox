#!/usr/bin/env bash
# srrb.prod — SRR backend, PRODUCTION. Runs the STATIC deployed binary (NOT the live dev
# build) against the prod config (srr.prod.yaml -> ~/public/srr, served at https://dev.llera.eu/srr/).
# The binary changes only when you run `srr-deploy deploy-be`, so prod never executes a
# half-finished dev build. Always uses prod config, ignoring any pre-set SRR_CONFIG / _INLINE.
# Use deliberately: this mutates what live users see. For dev work use plain `srrb`.
BIN=/home/gllera/.local/lib/srr/srrb
[ -x "$BIN" ] || { echo "srrb.prod: prod binary not deployed at $BIN — run: srr-deploy deploy-be" >&2; exit 127; }
unset SRR_CONFIG_INLINE
export SRR_CONFIG=/home/gllera/.config/srr/srr.prod.yaml
exec "$BIN" "$@"
