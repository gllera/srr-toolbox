#!/usr/bin/env srr-uvrun
"""SRR external ingest strategy: dev.to's top articles of the month -> SRR items.

Runs in the toolbox's shared uv project venv (repo-root pyproject.toml, via
the srr-uvrun shebang wrapper) like every bin/ script, though it needs
nothing beyond the standard library.

dev.to's public API ranks articles by reactions; `top=30` is the last 30
days. Each run asks for that ranking ONCE, drops what an earlier run already
sent, and fetches the body of each remaining article (one request each) to
emit one item per article: title, link, the cover image and the full HTML
body. Nothing else is carried (no author, reactions, comments or tags).

  drr feed add -t "dev.to top" -u "https://dev.to/" \\
    -i "srr-devto --lang en" --check-minutes 60

(or set "Check at most every: 1 h" in the feed editor). The ranking moves
slowly, so there is no point in asking more often.

HOW ARTICLES ARE PICKED
-----------------------
- The listing is `GET https://dev.to/api/articles?top=30&per_page=<N>`;
  `--top N` (1..1000, default 500) is N. The ranking's order is the order of
  the batch.
- `--lang en,es` keeps only articles whose `language` is in the list; an
  article with no `language` is dropped. Without `--lang` every language is
  kept.
- Articles already sent are skipped. Each item's `guid` is fnv1a32 of
  `dev.to/<id>`; `published` is always null (the ranking is out of date
  order, and drr drops items dated before its watermark).

STATE
-----
The response's `etag` is the state, echoed back by drr next run: compact JSON
`{"sent":{"<id>":<day>},"v":1}`, the day being the article's published date as
a UTC day number. Entries older than 31 days are pruned (an article that old
is no longer in the month's ranking). An etag that is not this shape (empty,
garbage, another strategy's watermark) starts from an empty state.

FAILURES AND BUDGET
-------------------
- A body answered 404 or 410 is skipped and recorded as sent: it is gone for
  good and is never requested again.
- Any other failure stops the batch: the items already fetched are returned
  with a state that includes exactly them, and the rest is retried next run.
  A run that emits nothing because of such a failure exits non-zero, so drr
  records the error. A failed listing request exits non-zero.
- No body request starts after 300 s into the run; the rest is fetched next
  run (the first run over 500 candidates takes a few runs). Body requests
  are spaced 0.2 s apart.
- Responses are read with gzip accepted and capped at the request's
  `max_size` (what drr sends; 5 MB on a manual run).

MANUAL RUNS (parameters instead of stdin)
-----------------------------------------
Normally drr drives this script by writing a JSON request to stdin. To try it
by hand, pass the URL as an argument; the result is pretty-printed:

  srr-devto --top 3 "https://dev.to/"
  srr-devto --top 3 --lang en "https://dev.to/"

  <url>                     must be https://dev.to/ (or https://dev.to)
  --lang CODES              comma-separated language codes to keep
  --top N                   candidates asked of the ranking (default 500)
  --ua STRING               the User-Agent to send (default below)
  --etag <value>            the state from the previous run
  --last-modified <value>   accepted for contract symmetry; unused
  --asset-dir <dir>         accepted for contract symmetry; unused
  --max-asset-size <bytes>  accepted for contract symmetry; unused
"""
import sys, re, json, html, zlib, time, urllib.request, urllib.error, http.client
from datetime import datetime, timezone

VERSION = "1.0"

DEFAULT_UA = "Mozilla/5.0 (compatible; drr/1.0)"
DEFAULT_MAX_SIZE = 5_000_000   # read cap when the request carries no max_size
DEFAULT_TOP = 500
MAX_TOP = 1000
TIMEOUT = 30
TIME_BUDGET_S = 300
PAUSE_S = 0.2
KEEP_DAYS = 31
API = "https://dev.to/api/articles"

# Per-process settings set by main() from argv before the request is built.
OPTS = {"lang": None, "top": DEFAULT_TOP, "ua": DEFAULT_UA}


def fnv1a32(s: str) -> int:
    h = 0x811C9DC5
    for b in s.encode("utf-8"):
        h = ((h ^ b) * 0x01000193) & 0xFFFFFFFF
    return h


def log(*a):
    print("srr-devto:", *a, file=sys.stderr)


# ---------------------------------------------------------------- dates

def parse_instant(s):
    """An ISO 8601 datetime -> an aware UTC datetime, or None."""
    if not s or not isinstance(s, str):
        return None
    s = s.strip()
    if s.endswith("Z") or s.endswith("z"):
        s = s[:-1] + "+00:00"
    try:
        d = datetime.fromisoformat(s)
    except ValueError:
        # fromisoformat before 3.11 wants exactly 3 or 6 fractional digits
        m = re.match(r"^(.*T\d\d:\d\d:\d\d)\.(\d+)(.*)$", s)
        if not m:
            return None
        frac = (m.group(2) + "000000")[:6]
        try:
            d = datetime.fromisoformat(f"{m.group(1)}.{frac}{m.group(3)}")
        except ValueError:
            return None
    if d.tzinfo is None:
        d = d.replace(tzinfo=timezone.utc)
    return d.astimezone(timezone.utc)


def day_of(published_at, today: int) -> int:
    d = parse_instant(published_at)
    return int(d.timestamp() // 86400) if d else today


# ---------------------------------------------------------------- HTTP

def fetch_json(url: str, cap: int):
    """GET url, gzip accepted, -> the decoded JSON body. Raises
    urllib.error.HTTPError / URLError / OSError on failure and ValueError on
    a body that is not JSON. The body is cut at cap bytes, before and after
    gzip decoding."""
    hdr = {"User-Agent": OPTS["ua"], "Accept-Encoding": "gzip",
           "Accept": "application/json"}
    r = urllib.request.urlopen(urllib.request.Request(url, headers=hdr), timeout=TIMEOUT)
    with r:
        raw = r.read(cap)
        enc = (r.headers.get("Content-Encoding") or "").lower()
    if enc == "gzip" or raw[:2] == b"\x1f\x8b":
        raw = zlib.decompressobj(16 + zlib.MAX_WBITS).decompress(raw, cap)
    return json.loads(raw.decode("utf-8"))


# ---------------------------------------------------------------- state

def parse_state(etag: str, today: int) -> dict:
    """The etag -> {id: day}, entries older than KEEP_DAYS dropped. Anything
    that is not this strategy's state is an empty state."""
    if not etag:
        return {}
    try:
        d = json.loads(etag)
        if not isinstance(d, dict) or d.get("v") != 1 or not isinstance(d.get("sent"), dict):
            raise ValueError("wrong shape")
        sent = {int(k): int(v) for k, v in d["sent"].items()}
    except (ValueError, TypeError, OverflowError):
        log("etag is not srr-devto state; starting from scratch")
        return {}
    return {k: v for k, v in sent.items() if v >= today - KEEP_DAYS}


def encode_state(sent: dict) -> str:
    return json.dumps({"v": 1, "sent": {str(k): sent[k] for k in sorted(sent)}},
                      sort_keys=True, separators=(",", ":"))


# ---------------------------------------------------------------- selection

def check_url(url) -> None:
    if url not in ("https://dev.to", "https://dev.to/"):
        raise ValueError(f"the feed URL must be https://dev.to/ (got {url})")


def list_url(top: int) -> str:
    return f"{API}?top=30&per_page={top}"


def select(articles: list, sent: dict, langs) -> list:
    """The ranking's articles still to send, in ranking order."""
    out, seen = [], set()
    for a in articles:
        if not isinstance(a, dict) or not isinstance(a.get("id"), int):
            continue
        i = a["id"]
        if i in sent or i in seen:
            continue
        if langs is not None and str(a.get("language") or "").lower() not in langs:
            continue
        seen.add(i)
        out.append(a)
    return out


def build_item(article: dict) -> dict:
    content = ""
    if article.get("cover_image"):
        content = f'<p><img src="{html.escape(article["cover_image"])}" alt=""></p>'
    content += article.get("body_html") or ""
    item = {
        "guid": fnv1a32(f"dev.to/{article['id']}"),
        "title": article.get("title") or "",
        "content": content,
        "link": article.get("url") or "",
        "published": None,
    }
    if article.get("language"):
        item["lang"] = article["language"]
    return item


class BatchStopped(Exception):
    """A body failed for a reason a retry may fix; the batch stops here."""


def fetch_body(article_id: int, cap: int):
    """-> the article's JSON, or None when it is gone for good (404/410).
    Raises BatchStopped on any other failure."""
    try:
        body = fetch_json(f"{API}/{article_id}", cap)
    except urllib.error.HTTPError as e:
        if e.code in (404, 410):
            return None
        raise BatchStopped(f"article {article_id}: HTTP {e.code}") from e
    except (urllib.error.URLError, OSError, http.client.HTTPException, ValueError) as e:
        raise BatchStopped(f"article {article_id}: {e}") from e
    if not isinstance(body, dict):
        raise BatchStopped(f"article {article_id}: unexpected response")
    return body


# ---------------------------------------------------------------- the run

def run_ingest(req, now=None, clock=time.monotonic, sleep=time.sleep):
    started = clock()
    check_url(req.get("url"))
    cap = int(req.get("max_size") or 0) or DEFAULT_MAX_SIZE
    today = int((time.time() if now is None else now) // 86400)
    etag = req.get("etag") or ""
    sent = parse_state(etag, today)
    listing = fetch_json(list_url(OPTS["top"]), cap)
    if not isinstance(listing, list):
        raise ValueError("the article listing is not a JSON array")
    batch = select(listing, sent, OPTS["lang"])

    new_sent = dict(sent)
    items, failure, fetched = [], None, 0
    for n, a in enumerate(batch):
        if clock() - started >= TIME_BUDGET_S:
            log(f"time budget reached; {len(batch) - n} article(s) left for the next run")
            break
        if fetched:
            sleep(PAUSE_S)
        fetched += 1
        try:
            body = fetch_body(a["id"], cap)
        except BatchStopped as e:
            failure = str(e)
            break
        if body is None:
            log(f"article {a['id']}: gone (404/410), skipped")
            new_sent[a["id"]] = day_of(a.get("published_at"), today)
            continue
        body.setdefault("id", a["id"])
        items.append(build_item(body))
        new_sent[a["id"]] = day_of(body.get("published_at") or a.get("published_at"), today)

    state = encode_state(new_sent)
    changed = state != etag and (etag or new_sent)
    if failure:
        if not items:
            raise BatchStopped(failure)
        log(f"{failure}; stopping the batch after {len(items)} item(s), "
            f"the rest is retried next run")
    log(f"{len(listing)} listed, {len(batch)} to send, {len(items)} item(s)")
    if items:
        return {"items": items, "etag": state}
    if changed:
        return {"items": [], "etag": state}
    return {"not_modified": True}


# ---------------------------------------------------------------- CLI

CLI_PARAMS = {"--etag": "etag", "--last-modified": "last_modified",
              "--asset-dir": "asset_dir", "--max-asset-size": "max_asset_size"}
OPT_PARAMS = {"--lang": "lang", "--top": "top", "--ua": "ua"}


def parse_options(argv):
    """Split the strategy's own options out of argv into OPTS (validated),
    returning the rest (the request parameters and the URL)."""
    rest, i = [], 0
    while i < len(argv):
        a = argv[i]
        if a in OPT_PARAMS:
            if i + 1 >= len(argv):
                sys.exit(f"srr-devto: {a} needs a value")
            key, val = OPT_PARAMS[a], argv[i + 1]
            if key == "top":
                try:
                    n = int(val)
                except ValueError:
                    n = 0
                if not 1 <= n <= MAX_TOP:
                    sys.exit(f"srr-devto: {a} must be an integer from 1 to {MAX_TOP}, got {val!r}")
                val = n
            elif key == "lang":
                val = {p.strip().lower() for p in val.split(",") if p.strip()}
                if not val:
                    sys.exit(f"srr-devto: {a} needs at least one language code")
            elif not val:
                sys.exit(f"srr-devto: {a} needs a non-empty value")
            OPTS[key] = val
            i += 2
        else:
            rest.append(a)
            i += 1
    return rest


def request_from_argv(argv):
    """CLI parameters -> the same request dict drr sends as JSON on stdin."""
    req, i = {}, 0
    while i < len(argv):
        a = argv[i]
        if a in CLI_PARAMS:
            if i + 1 >= len(argv):
                sys.exit(f"srr-devto: {a} needs a value")
            req[CLI_PARAMS[a]] = argv[i + 1]
            i += 2
        elif a.startswith("-"):
            sys.exit(f"srr-devto: unknown option {a!r} (see --help)")
        elif "url" in req:
            sys.exit(f"srr-devto: more than one URL given ({req['url']!r}, {a!r})")
        else:
            req["url"] = a
            i += 1
    if "url" not in req:
        sys.exit("srr-devto: missing URL (see --help)")
    if "max_asset_size" in req:
        try:
            req["max_asset_size"] = int(req["max_asset_size"])
        except ValueError:
            sys.exit(f"srr-devto: --max-asset-size must be a byte count, "
                     f"got {req['max_asset_size']!r}")
    return req


def cmd_ingest(req=None):
    # req is built from CLI parameters (manual run) or, when None, read as the
    # JSON request drr writes to stdin (the external-ingest contract).
    pretty = req is not None
    if req is None:
        try:
            req = json.load(sys.stdin)
        except json.JSONDecodeError as e:
            sys.exit(f"srr-devto: could not parse request on stdin: {e}")
    try:
        result = run_ingest(req)
    except (urllib.error.URLError, OSError, http.client.HTTPException) as e:
        sys.exit(f"srr-devto: listing fetch failed: {e}")
    except ValueError as e:
        sys.exit(f"srr-devto: {e}")
    except BatchStopped as e:
        sys.exit(f"srr-devto: {e}")
    if pretty:
        json.dump(result, sys.stdout, indent=2, ensure_ascii=False)
        print()
    else:
        json.dump(result, sys.stdout)


def main():
    argv = sys.argv[1:]
    if argv and argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    if argv and argv[0] in ("version", "--version", "-V"):
        print("srr-devto", VERSION)
        return
    argv = parse_options(argv)
    cmd_ingest(request_from_argv(argv) if argv else None)


if __name__ == "__main__":
    main()
