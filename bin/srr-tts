#!/usr/bin/env srr-uvrun
"""SRR external pipeline step: prepend a self-hosted TTS narration to articles.

srr execs any non-#builtin `pipe` entry once per item, writing the item JSON
to stdin and reading the (possibly modified) item JSON back from stdout:

    {guid, title, content, link, published, lang?, raw, drop?}

This step narrates title + body text with piper (fully offline) and prepends

    <p><audio controls preload="none" src="#/tts/<hash>.wav"></audio></p>

The "#/"-marker file is written under the fetch run's asset dir; srr's
end-of-pipeline upload step ships it to the store content-addressed (and the
store-side asset processor — webify on this deployment — transcodes the WAV
to web audio before upload).

Opt a feed in (order matters: after #readability if the feed uses it, before
#default so the marker rides the normal sanitize/upload path):

    srr feed upd <id> -p 'srr-tts --voice es_ES-davefx-medium' -p '#default'

VOICE RESOLUTION (first hit wins)
---------------------------------
  1. --voice <name>          explicit piper voice, e.g. en_US-lessac-medium
  2. --lang-voice xx=voice   per-feed extension/override of the table (repeatable)
  3. built-in table          keyed by the item's `lang` field (en es fr de pt it)
  none resolvable -> the item passes through unchanged (logged to stderr).
  srr auto-detects `lang` BEFORE the pipeline runs (a declared value from
  the ingest strategy wins; short/uncertain text leaves it empty), so the
  language-keyed table works on plain feeds too. Use --voice to force a
  voice when detection stays empty or picks wrong.

The asset dir arrives as $SRR_ASSET_DIR (set by srr on the fetch path; absent
in `srr preview` and older backends -> pass through, never synthesize).
Synthesized WAVs are cached there under tts/ keyed by voice+text hash: a
cache hit only refreshes the file's mtime (so srr's age-based sweep keeps
live files) and never re-synthesizes.

KNOBS
-----
  --voice <name>            explicit piper voice (wins over everything)
  --lang-voice xx=voice     extend/override the language->voice table (repeatable)
  --max-chars <n>           narration cap, default 3000; truncated at a
                            sentence boundary. This bound is a SAFETY limit,
                            not a preference: srr drops an item whose pipe
                            step exits non-zero or times out, and keeps its
                            guid in BoundaryGUIDs, so a --cmd-timeout kill
                            loses the article permanently (never retried).
                            Measured (piper medium voice, Latin prose): ~1000
                            chars per MINUTE of speech (~17 chars/s) and
                            ~2.6 MB of WAV per 1000 chars, so 3000 chars is
                            ~3 min of audio / ~7.8 MB. End-to-end on a 4-core
                            ARM64 box (the class that runs the fetch loop):
                            41s synthesis + 2s model load, plus a one-off 60
                            MB voice download on first use (1.5s there, but
                            it rides the SAME --cmd-timeout, so on a slow
                            link pre-warm the voice with a manual run before
                            opting a feed in). ~45s against the 5m default.
                            Note the cap counts CHARACTERS: the ratios above
                            are Latin-script; a CJK voice packs far more
                            speech per character, so re-measure before
                            reusing this default there. 0 disables the cap:
                            only do that on a feed whose length you know.
  --voices-dir <dir>        piper models dir (default $XDG_DATA_HOME else
                            ~/.local/share, + /srr-tts); models auto-download
                            there on first use. Deliberately OUTSIDE srr's
                            age-swept asset cache.
  --asset-dir <dir>         manual runs: where tts/ audio goes (what
                            $SRR_ASSET_DIR carries on the fetch path)

MANUAL RUNS (parameters instead of stdin)
-----------------------------------------
Pass an HTML file as argument instead of item JSON on stdin — the same item
dict is built from parameters and the result is pretty-printed:

    srr-tts --voice es_ES-davefx-medium --asset-dir /tmp/store article.html
    srr-tts --lang es --asset-dir /tmp/store --title "Titular" article.html

  <file>                    HTML file whose content becomes the item body
  --title <text>            item title (narrated first)
  --lang <xx>               item lang field (drives the voice table)
"""
import hashlib
import html
import json
import os
import re
import shutil
import sys
import tempfile
import time
import wave

from bs4 import BeautifulSoup

VERSION = "1.0"

DEFAULT_MAX_CHARS = 3_000

# language (lowercase primary subtag, the item's `lang` field) -> default
# piper voice. --lang-voice overrides/extends per feed; --voice bypasses it.
# All "medium" on purpose: one quality tier across languages, so the size and
# timing figures documented for --max-chars hold whichever voice is picked.
LANG_VOICES = {
    "en": "en_US-lessac-medium",
    "es": "es_ES-davefx-medium",
    "fr": "fr_FR-siwis-medium",
    "de": "de_DE-thorsten-medium",
    "pt": "pt_BR-faber-medium",
    "it": "it_IT-paola-medium",
}

AUDIO_HTML = '<p><audio controls preload="none" src="%s"></audio></p>'

# piper's own voice-name grammar (download_voices.VOICE_PATTERN): the
# downloader REBUILDS the filename from these groups, so a name that doesn't
# match — or that carries stray whitespace, which it strips — makes it write
# files under a different name than we then look for. Validating at parse time
# turns "every item of this feed fails forever, one 60 MB download each" into
# one loud startup error.
VOICE_RE = re.compile(r"^[^-\s]+_[^-\s]+-[^-\s]+-\S+$")

# A voice model is downloaded into a .dl-* staging dir; a SIGKILL (srr's
# --cmd-timeout) skips the cleanup, and voices_dir is deliberately outside
# srr's age-swept cache, so nothing else reclaims them. Sweep our own debris,
# but only when it is far older than any live download could be.
STAGE_TTL = 6 * 3600

# After a failed load we re-download once, assuming a corrupt cache. But
# "failed to load" also covers environmental faults (OOM on a small box, fd
# exhaustion) that a re-download cannot fix — and srr runs one process per
# item, so nothing in-process remembers a failed heal. The model's mtime is
# that memory: a model touched more recently than this was already healed,
# so don't pull 60 MB again for every item of the feed.
HEAL_COOLDOWN = 3600


def log(*a):
    print("srr-tts:", *a, file=sys.stderr)


def fnv1a32(s: str) -> int:
    h = 0x811C9DC5
    for b in s.encode("utf-8"):
        h = ((h ^ b) * 0x01000193) & 0xFFFFFFFF
    return h


# Subtrees that must never reach the narration (content is pre-#sanitize
# here: scripts/styles may still be present; audio/video keeps a re-run from
# narrating its own player markup) and elements whose boundaries read as
# paragraph breaks. Inline tags (a, b, span, ...) flow into the sentence.
DROP_TAGS = ("script", "style", "noscript", "template", "iframe",
             "audio", "video", "svg", "math", "head")
BLOCK_TAGS = ("p", "div", "li", "ul", "ol", "blockquote", "pre", "table",
              "tr", "figure", "figcaption", "article", "section", "aside",
              "header", "footer", "details", "summary",
              "h1", "h2", "h3", "h4", "h5", "h6",
              "dl", "dt", "dd", "td", "th", "caption")


def html_to_text(fragment: str) -> str:
    """HTML fragment -> plain text. Attribute text (alt, URLs) is never
    included; block boundaries become paragraph breaks so piper phrases them
    as pauses."""
    soup = BeautifulSoup(fragment or "", "html.parser")
    for t in soup(list(DROP_TAGS)):
        t.decompose()
    for br in soup.find_all("br"):
        br.replace_with("\n")
    for t in soup.find_all(list(BLOCK_TAGS)):
        t.insert_before("\n\n")
        t.insert_after("\n\n")
    text = soup.get_text()
    text = re.sub(r"[ \t\r\f\v]+", " ", text)
    text = re.sub(r" ?\n ?", "\n", text)
    return re.sub(r"\n{3,}", "\n\n", text).strip()


def extract_text(title: str, content_html: str) -> str:
    """Item title + content HTML -> the plain text to narrate. '' when there
    is nothing to say.

    The title goes through the same conversion as the body: a feed title is
    NOT plain text — it routinely carries entities ("Tom &amp; Jerry",
    "It&#8217;s") and sometimes markup, and srr only unescapes and sanitizes
    it AFTER the pipeline, so this step always sees the raw form. Narrating
    that verbatim makes piper read the entity out loud. Collapsed to one line
    because a title is one utterance."""
    body = html_to_text(content_html)
    title = " ".join(html_to_text(title).split())
    if title and body:
        return title + "\n\n" + body
    return title or body


SENTENCE_END = re.compile(r"[.!?…](?=\s)")


def truncate(text: str, cap: int):
    """-> (text, truncated?). Over-cap text is cut at the last sentence end
    past 60% of the cap, else hard at the cap (a boundary too early would
    silently drop most of the article)."""
    if cap <= 0 or len(text) <= cap:
        return text, False
    cut = text[:cap]
    ends = [m.end() for m in SENTENCE_END.finditer(cut)]
    if ends and ends[-1] >= int(cap * 0.6):
        return cut[: ends[-1]].rstrip(), True
    return cut.rstrip(), True


def audio_name(voice: str, text: str) -> str:
    """Store-relative name for a narration: content-addressed by voice+text
    so identical inputs reuse the same cache file (and dedup in the store)."""
    h = hashlib.sha256((voice + "\n" + text).encode("utf-8")).hexdigest()
    return "tts/%s.wav" % h[:32]


def default_voices_dir() -> str:
    # XDG data dir, NOT srr's asset cache: the cache is age-swept, voice
    # models are not per-run artifacts.
    base = os.environ.get("XDG_DATA_HOME") or os.path.join(
        os.path.expanduser("~"), ".local", "share")
    return os.path.join(base, "srr-tts")


def norm_lang(s: str) -> str:
    """Fold a language tag to the bare lowercase primary subtag ('ES' -> 'es',
    'pt-BR' -> 'pt'), mirroring the backend's normalizeLang. srr's own
    detection already emits bare codes, but the wire protocol lets an ingest
    strategy DECLARE lang (an RSS <language> copied verbatim) and srr never
    folds that onto the item — so fold here, or a declared 'pt-BR' silently
    misses the table."""
    return re.split(r"[-_]", s.strip().lower(), maxsplit=1)[0]


def resolve_voice(cfg: dict, language: str):
    """--voice > --lang-voice/built-in table by language > None."""
    if cfg["voice"]:
        return cfg["voice"]
    return cfg["lang_voices"].get(norm_lang(language or ""))


def fetch_voice(voice: str, voices_dir: str, onnx: str, conf: str):
    """Download a voice's two files into voices_dir, atomically.

    piper's own downloader skips any file that merely exists and is non-empty
    and writes straight to the destination, so a run killed mid-download —
    srr's --cmd-timeout can land there, the model is ~60 MB — would leave a
    truncated .onnx that is NEVER re-downloaded and fails load every cycle
    after. So stage into a sibling temp dir and os.replace each file into
    place (same filesystem, so the rename is atomic). Two feeds racing on a
    voice's first use both stage their own copy; last replace wins, same
    Note this covers the KILL case, not a silently short HTTP body: piper
    checks neither Content-Length nor the md5 upstream publishes, so a dropped
    connection still returns "success". ensure_voice's load-failure heal is
    what catches that.

    The piper import stays inside — see ensure_voice."""
    from pathlib import Path
    from piper.download_voices import download_voice
    os.makedirs(voices_dir, exist_ok=True)
    sweep_stale_stages(voices_dir)
    log("downloading voice %s -> %s" % (voice, voices_dir))
    stage = tempfile.mkdtemp(dir=voices_dir, prefix=".dl-")
    try:
        download_voice(voice, Path(stage))
        for dest in (onnx, conf):
            os.replace(os.path.join(stage, os.path.basename(dest)), dest)
    finally:
        shutil.rmtree(stage, ignore_errors=True)


def sweep_stale_stages(voices_dir: str):
    """Reclaim .dl-* staging dirs an interrupted run left behind. The finally
    above cannot run on SIGKILL, and voices_dir sits outside srr's age-swept
    cache, so without this a killed download leaks ~60 MB permanently and
    every retry can leak another. Only dirs older than STAGE_TTL go, so a
    concurrent worker's live download is never pulled out from under it."""
    cutoff = time.time() - STAGE_TTL
    try:
        names = os.listdir(voices_dir)
    except OSError:
        return
    for name in names:
        if not name.startswith(".dl-"):
            continue
        path = os.path.join(voices_dir, name)
        try:
            stale = os.path.getmtime(path) < cutoff
        except OSError:
            continue
        if stale:
            log("removing stale download staging dir %s" % path)
            shutil.rmtree(path, ignore_errors=True)


def ensure_voice(voice: str, voices_dir: str):
    """Load the piper voice, downloading its model on first use. Imports stay
    inside: onnxruntime is heavy and pass-through runs must not pay for it.

    A voice is two files (PiperVoice.load derives the .onnx.json config from
    the model path) and both must be complete. Missing files are the cheap
    case; a file that is present but CORRUPT is not detectable by stat, so a
    load failure is treated as a poisoned cache and healed by one
    re-download. Without that, anything that predates the staged download
    above — or a short HTTP body, which piper does not detect — wedges the
    voice permanently: every cycle would fail load and pass the item through.

    The heal is rate-limited by the model's own mtime (HEAL_COOLDOWN),
    because a load failure is not proof of corruption: OOM on a small box
    fails the same way, and re-downloading 60 MB for every item of the feed
    would turn a memory problem into a bandwidth one."""
    from piper import PiperVoice
    onnx = os.path.join(voices_dir, voice + ".onnx")
    conf = onnx + ".json"
    if not (os.path.exists(onnx) and os.path.exists(conf)):
        fetch_voice(voice, voices_dir, onnx, conf)
    try:
        return PiperVoice.load(onnx)
    except Exception as e:
        try:
            healed_recently = time.time() - os.path.getmtime(onnx) < HEAL_COOLDOWN
        except OSError:
            healed_recently = False
        if healed_recently:
            raise  # freshly fetched and still broken — a re-download won't fix it
        log("voice %s failed to load (%s): re-downloading" % (voice, e))
        fetch_voice(voice, voices_dir, onnx, conf)
        return PiperVoice.load(onnx)


def synthesize(voice_obj, text: str, dest: str):
    """Synthesize text to dest as WAV. .part + rename so a killed run never
    leaves a truncated file for a later cycle (or a concurrent worker) to
    reuse. The temp name is PID-suffixed so two concurrent workers
    synthesizing the same voice+text can't tear each other's write (last
    os.replace wins, which is harmless — same bytes)."""
    tmp = "%s.%d.part" % (dest, os.getpid())
    os.makedirs(os.path.dirname(dest), exist_ok=True)
    try:
        with wave.open(tmp, "wb") as w:
            voice_obj.synthesize_wav(text, w)
        os.replace(tmp, dest)
    finally:
        if os.path.exists(tmp):
            try:
                os.remove(tmp)
            except OSError:
                pass


def run_item(item: dict, cfg: dict) -> dict:
    """One item through the step. Narration is an enhancement: every per-item
    problem logs to stderr and returns the item unchanged — never fail the
    feed's cycle."""
    asset_dir = cfg["asset_dir"]
    if not asset_dir:
        log("no asset dir (preview or old backend): passing item through")
        return item
    text = extract_text(item.get("title") or "", item.get("content") or "")
    if not text:
        log("nothing to narrate: passing item through")
        return item
    text, truncated = truncate(text, cfg["max_chars"])
    if truncated:
        log("narration truncated to %d chars (cap %d)"
            % (len(text), cfg["max_chars"]))
    voice = resolve_voice(cfg, item.get("lang") or "")
    if not voice:
        log("no voice for language %r: passing item through"
            % (item.get("lang") or ""))
        return item
    rel = audio_name(voice, text)
    dest = os.path.join(asset_dir, rel)
    if os.path.exists(dest) and os.path.getsize(dest) > 0:
        # Refresh the mtime so srr's post-cycle age-based cache sweep never
        # deletes a file a live feed still consumes (srr-youtube's pattern).
        os.utime(dest, None)
    else:
        try:
            synthesize(ensure_voice(voice, cfg["voices_dir"]), text, dest)
        except Exception as e:  # any failure degrades — never fails the cycle
            log("synthesis failed (%s): %s" % (voice, e))
            return item
    item["content"] = (AUDIO_HTML % html.escape("#/" + rel, quote=True)
                       + (item.get("content") or ""))
    return item


CFG_PARAMS = {"--voice": "voice", "--max-chars": "max_chars",
              "--voices-dir": "voices_dir", "--asset-dir": "asset_dir"}
ITEM_PARAMS = {"--title": "title", "--lang": "lang"}


def check_voice(name: str, errors: list) -> str:
    """Validate a voice name against piper's grammar, at parse time. piper
    only rejects it at first synthesis — which, since srr runs one process
    per item, means a silent per-item failure forever (and, for a name that
    merely has stray whitespace, a completed 60 MB download thrown away each
    time)."""
    if not VOICE_RE.match(name):
        errors.append("%r is not a piper voice name "
                      "(want lang_REGION-name-quality, e.g. en_US-lessac-medium)"
                      % name)
    return name


def parse_argv(argv):
    """-> (cfg, item-or-None). Manual mode (an HTML file argument) builds the
    same item dict srr sends as JSON on stdin (the toolbox's same-request
    rule); protocol mode returns item=None and main reads stdin.

    Argv errors are COLLECTED, not raised, because what a bad flag should do
    depends on the mode and we only know the mode once the whole argv is
    read. A human at a terminal wants a non-zero exit; the fetch path must
    never get one — srr drops an item whose step exits non-zero and never
    retries it, and it does not validate external steps up front, so one
    typo'd flag in a feed's `pipe` would silently destroy every article that
    feed ever publishes. In protocol mode a config error therefore degrades
    exactly like a per-item failure: complain on stderr, change nothing.

    Which mode we are in is decided by whether the file argument OPENS (see
    below), not by whether one was supplied — a mis-parsed flag value looks
    exactly like a filename, and guessing wrong costs articles."""
    cfg = {"voice": "", "max_chars": DEFAULT_MAX_CHARS,
           "voices_dir": default_voices_dir(),
           "asset_dir": os.environ.get("SRR_ASSET_DIR", ""),
           "lang_voices": dict(LANG_VOICES), "error": ""}
    errors = []
    manual = {}
    paths = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in CFG_PARAMS or a in ITEM_PARAMS or a == "--lang-voice":
            if i + 1 >= len(argv):
                errors.append("%s needs a value" % a)
                break
            val = argv[i + 1]
            if a == "--lang-voice":
                lang, sep, v = val.partition("=")
                if not sep or not lang or not v:
                    errors.append("--lang-voice wants xx=voice, got %r" % val)
                else:
                    cfg["lang_voices"][norm_lang(lang)] = check_voice(v, errors)
            elif a == "--voice":
                cfg["voice"] = check_voice(val, errors)
            elif a in CFG_PARAMS:
                cfg[CFG_PARAMS[a]] = val
            else:
                manual[ITEM_PARAMS[a]] = val
            i += 2
        elif a.startswith("-"):
            errors.append("unknown option %r (see --help)" % a)
            i += 1
        else:
            paths.append(a)
            i += 1
    try:
        cfg["max_chars"] = int(cfg["max_chars"])
    except (TypeError, ValueError):
        errors.append("--max-chars must be an integer, got %r" % cfg["max_chars"])
        cfg["max_chars"] = DEFAULT_MAX_CHARS
    if cfg["max_chars"] < 0:
        # truncate() treats any cap <= 0 as "no cap"; a negative almost
        # certainly means a typo, and silently uncapping is the one outcome
        # that can lose articles to --cmd-timeout. Say so.
        errors.append("--max-chars cannot be negative (0 disables the cap)")
    if not paths and manual:
        errors.append("--title/--lang need an HTML file argument "
                      "(protocol mode reads the item from stdin)")
    # Manual mode is confirmed by OPENING the file, never by merely seeing a
    # positional — an unknown flag's orphaned value ("--voce es_ES-x-medium")
    # is indistinguishable from a filename, and a stray token in a feed's
    # `pipe` looks like one too. Reading a file is the only evidence a human
    # is driving this, so it is the only thing that may authorize a non-zero
    # exit; anything else degrades to the fetch-safe path.
    # The FIRST positional that opens is the file: an unknown flag's orphaned
    # value sits in the positional list too, ahead of the real filename.
    content = None
    for candidate in paths:
        try:
            with open(candidate, "r", encoding="utf-8", errors="replace") as fh:
                content = fh.read()
            break
        except OSError as e:
            last_err = e
    if paths and content is None:
        errors.append("cannot read %s: %s" % (paths[0], last_err))
    elif len(paths) > 1 and not errors:
        errors.append("more than one input file (%s)"
                      % ", ".join(repr(p) for p in paths))
    if errors:
        if content is not None:
            sys.exit("srr-tts: " + errors[0])   # confirmed manual run
        cfg["error"] = errors[0]
        return cfg, None
    if content is None:
        return cfg, None
    item = {
        "guid": fnv1a32(content),
        "title": manual.get("title", ""),
        "content": content,
        "link": "",
        "published": None,
    }
    if manual.get("lang"):
        item["lang"] = manual["lang"]
    return cfg, item


def main():
    argv = sys.argv[1:]
    if argv and argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    if argv and argv[0] in ("version", "--version", "-V"):
        print("srr-tts", VERSION)
        return
    cfg, item = parse_argv(argv)
    pretty = item is not None
    if cfg["error"]:
        # Protocol mode only (a manual run already exited). Emitting nothing
        # is srr's documented "leave the item unchanged" — the one response
        # that neither drops the article nor pretends we narrated it.
        log("%s: passing items through unchanged" % cfg["error"])
        return
    if item is None:
        try:
            item = json.load(sys.stdin)
        except json.JSONDecodeError as e:
            # Same reasoning: a non-zero exit here would cost the article.
            log("could not parse item on stdin (%s): emitting nothing" % e)
            return
    try:
        result = run_item(item, cfg)
    except Exception as e:
        # Absolute backstop: run_item mutates item["content"] only as its
        # final statement, so on any raise (e.g. a cache-hit TOCTOU between
        # the getsize/utime checks and a concurrent evictor) the item is
        # still pristine — emit it untouched rather than exit non-zero and
        # have srr drop the article.
        log("unexpected error: %s: passing item through" % e)
        result = item
    if pretty:
        json.dump(result, sys.stdout, indent=2, ensure_ascii=False)
        print()
    else:
        json.dump(result, sys.stdout)


if __name__ == "__main__":
    main()
