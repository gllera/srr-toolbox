#!/usr/bin/env srr-uvrun
"""SRR external ingest strategy: a YouTube channel's Atom feed -> SRR items.

Runs in the toolbox's shared uv project venv (repo-root pyproject.toml, via
the srr-uvrun shebang wrapper) like every bin/ script, though it needs
nothing beyond the standard library.

YouTube already serves a valid Atom feed, but #rss leaves the body empty because
the description/thumbnail live one level down inside <media:group>. This command
fetches that feed and synthesizes a clickable-thumbnail + description body that
survives #sanitize (no <iframe>; img src / a href are allowlisted).

Subscribe with the channel's Atom URL, e.g.:
  srr feed add -t "Veritasium" \
    -u "https://www.youtube.com/feeds/videos.xml?channel_id=UCHnyfMqiRRG1u-2MsSQLbXA" \
    -i "srr-youtube"

SELF-HOSTING THUMBNAILS — --selfhost
------------------------------------
By default thumbnails (like the videos themselves) stay hotlinked at their
original i.ytimg.com URLs — the strategy downloads nothing but the feed XML,
and the store hosts no assets for it. Add --selfhost to download each video's
poster thumbnail into the SRR store instead, still picking the best quality
the ladder finds (the video itself is never downloaded in either mode — the
poster links out to youtube.com):

  srr feed add -t "Veritasium" \
    -u "https://www.youtube.com/feeds/videos.xml?channel_id=UCHnyfMqiRRG1u-2MsSQLbXA" \
    -i "srr-youtube --selfhost"

A thumbnail that can't be downloaded (CDN hiccup, over srr's --max-asset-size
cap) falls back to its hotlink: unlike Telegram's token-signed preview CDN,
i.ytimg.com URLs are public and stable, so degrading beats failing the cycle.
`srr preview` sends no asset_dir (self-hosting off), so previews hotlink too.

TRIMMING BOILERPLATE — --trim
-----------------------------
Some channels' descriptions are mostly boilerplate: a support/social link dump,
merch, Patreon, hashtags, a separator line followed by promos. With --trim each
description is cut down before rendering:

  1. everything from the first separator line on is dropped (a line of 3 or more
     of one character among ━ ─ — - _ = * ~ ═, whitespace ignored);
  2. every paragraph that is mostly links, @handles or #hashtags is dropped (at
     least 60 % of its tokens; a "Label:" right before a URL counts with the URL,
     and tokens with no letter or digit, like an arrow, are not counted);
  3. every paragraph that is only a call to action with a link is dropped (it
     starts with an emoji or arrow, holds a URL and has at most 12 words besides).

Summary paragraphs, chapter lists (lines starting 0:00 / 00:00 / 1:02:03) and prose
with an occasional link stay. A description trimmed to nothing leaves the thumbnail
alone. The flag works the same on the stdin path:

  srr feed add -t "Veritasium" -u "https://www.youtube.com/feeds/videos.xml?channel_id=UC..." \
    -i "srr-youtube --trim"

MANUAL RUNS (parameters instead of stdin)
-----------------------------------------
Normally srr drives this script by writing a JSON request to stdin. To test a
feed by hand, pass the URL as an argument instead — the request is built from
parameters and the result is pretty-printed:

  srr-youtube "https://www.youtube.com/feeds/videos.xml?channel_id=UC..."
  srr-youtube --selfhost "https://www.youtube.com/feeds/videos.xml?channel_id=UC..." \
    --asset-dir /tmp/store

  <url>                     the channel's Atom feed URL
  --etag <value>            HTTP ETag from the previous run (sent as
                            If-None-Match; unchanged feed -> not_modified)
  --last-modified <value>   HTTP Last-Modified from the previous run
                            (sent as If-Modified-Since)
  --asset-dir <dir>         store dir to download thumbnails into (what srr
                            sends as asset_dir; only used with --selfhost)
  --max-asset-size <bytes>  per-file thumbnail cap (absent/0 = no cap)
"""
import sys, os, re, json, html, http.client, urllib.request, urllib.error
import xml.etree.ElementTree as ET

NS = {
    "a":  "http://www.w3.org/2005/Atom",
    "m":  "http://search.yahoo.com/mrss/",
    "yt": "http://www.youtube.com/xml/schemas/2015",
}

VERSION = "1.2"

UA = {"User-Agent": "SRR-youtube"}
MAX_FEED_BYTES = 8_000_000   # feed-XML read cap (the request carries no knob for it)
SELFHOST = False   # set by --selfhost in main(); thumbnails download only when set
TRIM = False       # set by --trim in main(); descriptions are trimmed only when set


def fnv1a32(s: str) -> int:
    h = 0x811C9DC5
    for b in s.encode("utf-8"):
        h = ((h ^ b) * 0x01000193) & 0xFFFFFFFF
    return h


def log(*a):
    print("srr-youtube:", *a, file=sys.stderr)


def fetch_feed(req):
    """GET the Atom feed honoring the etag/last-modified cursor.
    -> (body, etag, last_modified), or None when nothing changed (304)."""
    hdr = dict(UA)
    if req.get("etag"):
        hdr["If-None-Match"] = req["etag"]
    if req.get("last_modified"):
        hdr["If-Modified-Since"] = req["last_modified"]
    try:
        r = urllib.request.urlopen(
            urllib.request.Request(req["url"], headers=hdr), timeout=30)
    except urllib.error.HTTPError as e:
        if e.code == 304:                 # nothing new since our cursor
            return None
        raise
    body = r.read(MAX_FEED_BYTES)
    return body, r.headers.get("ETag", ""), r.headers.get("Last-Modified", "")


# Thumbnail quality ladder: the Atom feed always declares hqdefault.jpg (480x360),
# but most videos have larger variants on the same CDN. Probe with HEAD requests
# (zero image bytes in hotlink mode) and keep the first that exists; a 404 means
# the uploader never provided that size. Any other failure (timeout, DNS) latches
# probing off for the rest of the run so a CDN hiccup degrades quality once
# instead of stalling on every item. --selfhost rides the same ladder — GETting
# into the store instead of probing — and shares the latch.
THUMB_VARIANTS = ("maxresdefault", "sddefault")   # 1280x720, 640x480
probing = True


def best_thumb(vid: str, feed_url: str) -> str:
    global probing
    for v in THUMB_VARIANTS:
        if not probing or not vid:
            break
        u = f"https://i.ytimg.com/vi/{vid}/{v}.jpg"
        try:
            urllib.request.urlopen(
                urllib.request.Request(u, method="HEAD", headers=UA), timeout=5)
            return u
        except urllib.error.HTTPError:
            continue          # this size doesn't exist for this video
        except OSError:
            probing = False   # network trouble, not a missing size
    return feed_url


def download(url: str, dest: str, cap: int) -> str:
    """Stream url to dest honoring the byte cap; a partial file never lands at
    dest (.part + rename, so a run killed mid-download can't leave a truncated
    file for a later cycle to reuse). -> 'ok' | 'toobig' | 'missing' | 'error'."""
    tmp = dest + ".part"
    try:
        with urllib.request.urlopen(
                urllib.request.Request(url, headers=UA), timeout=30) as r:
            clen = int(r.headers.get("Content-Length") or 0)
            if cap and clen > cap:
                return "toobig"
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            n = 0
            with open(tmp, "wb") as fh:
                while True:
                    chunk = r.read(256 * 1024)
                    if not chunk:
                        break
                    n += len(chunk)
                    if cap and n > cap:
                        return "toobig"
                    fh.write(chunk)
        if n == 0 or (clen and n != clen):
            return "error"    # empty or truncated body
        os.replace(tmp, dest)
        return "ok"
    except urllib.error.HTTPError as e:
        return "missing" if e.code == 404 else "error"
    except (OSError, ValueError, http.client.HTTPException):
        # HTTPException covers IncompleteRead: a server closing early with a
        # Content-Length set raises it mid-read, and it is NOT an OSError.
        return "error"
    finally:
        if os.path.exists(tmp):
            try:
                os.remove(tmp)
            except OSError:
                pass


def selfhost_thumb(vid: str, feed_url: str, asset_dir: str, cap: int):
    """Download the best thumbnail variant into the store. -> '#/yt/<vid>.jpg'
    marker, or None to fall back to hotlinking (over-cap file, CDN trouble)."""
    global probing
    rel = f"yt/{vid}.jpg"
    dest = os.path.join(asset_dir, rel)
    if os.path.exists(dest) and os.path.getsize(dest) > 0:
        # Refresh the mtime so srr's post-cycle age-based cache sweep never
        # deletes a file a live feed still consumes.
        os.utime(dest, None)
        return "#/" + rel
    candidates = [f"https://i.ytimg.com/vi/{vid}/{v}.jpg" for v in THUMB_VARIANTS]
    if feed_url:
        candidates.append(feed_url)
    for u in candidates:
        if not probing:
            return None
        st = download(u, dest, cap)
        if st == "ok":
            return "#/" + rel
        if st == "missing":
            continue          # this size doesn't exist for this video
        if st == "toobig":    # a smaller variant may still fit the cap
            log(f"thumb {vid}: {u.rsplit('/', 1)[-1]} over asset cap {cap}")
            continue
        probing = False       # network trouble, not a missing size
    return None


def thumb_src(vid: str, feed_url: str, asset_dir: str, cap: int) -> str:
    # --selfhost needs a store (srr preview sends none) and a video id to name
    # the file; any download fallback hotlinks instead — i.ytimg.com URLs are
    # public and stable, so the item stays correct either way.
    if SELFHOST and asset_dir and vid:
        marker = selfhost_thumb(vid, feed_url, asset_dir, cap)
        if marker:
            return marker
    return best_thumb(vid, feed_url)


PARA_SPLIT_RE = re.compile(r"\n[ \t]*\n+")


def desc_html(text):
    """Description -> <p> paragraphs: a blank line separates paragraphs, a lone
    newline is a soft <br> — blank lines never become <br><br> (the same
    invariant srr-telegram's text_to_html keeps)."""
    parts = []
    for para in PARA_SPLIT_RE.split((text or "").strip()):
        para = para.strip()
        if para:
            parts.append("<p>%s</p>" % html.escape(para).replace("\n", "<br>"))
    return "".join(parts)


SEPARATOR_CHARS = "━─—-_=*~═"
TIMESTAMP_RE = re.compile(r"^\s*(?:\d{1,2}:)?\d{1,2}:\d{2}\b")
URL_RE = re.compile(r"^(?:https?://|www\.)\S+$", re.I)
MENTION_RE = re.compile(r"^[@#]\w\S*$")
LINK_SHARE = 0.6    # a paragraph this share link/@handle/#tag tokens is boilerplate
CTA_WORDS = 12      # a call to action has at most this many words besides its URL


def is_separator(line):
    t = "".join(line.split())
    return len(t) >= 3 and t[0] in SEPARATOR_CHARS and t == t[0] * len(t)


def is_link_token(tok):
    return bool(URL_RE.match(tok) or MENTION_RE.match(tok))


def boilerplate_paragraph(para):
    """True for a paragraph --trim drops: mostly links/@handles/#tags, or a
    one-line call to action with a link. Chapter lists never are."""
    if any(TIMESTAMP_RE.match(l) for l in para.splitlines()):
        return False
    raw = para.split()
    # tokens with no letter or digit (arrows, bullets, emoji) are neutral
    toks = [t for t in raw if any(c.isalnum() for c in t)]
    n_link = 0
    for i, t in enumerate(toks):
        # "Patreon: https://..." — the label belongs to the link it introduces
        if is_link_token(t) or (t.endswith(":") and i + 1 < len(toks)
                                and URL_RE.match(toks[i + 1])):
            n_link += 1
    if toks and n_link >= LINK_SHARE * len(toks):
        return True
    first = para.lstrip()[:1]
    if first and not first.isalnum() and any(URL_RE.match(t) for t in raw):
        if len([t for t in toks if not URL_RE.match(t)]) <= CTA_WORDS:
            return True
    return False


def trim_description(text):
    """--trim: the description without its boilerplate (see the module doc)."""
    lines = (text or "").splitlines()
    for i, l in enumerate(lines):
        if is_separator(l):
            lines = lines[:i]
            break
    paras = PARA_SPLIT_RE.split("\n".join(lines).strip())
    return "\n\n".join(p for p in paras if p.strip() and not boilerplate_paragraph(p))


def build_items(body, asset_dir, cap):
    items = []
    for e in ET.fromstring(body).findall("a:entry", NS):
        vid = e.findtext("yt:videoId", "", NS)
        eid = e.findtext("a:id", "", NS)
        title = e.findtext("a:title", "", NS)
        pub = e.findtext("a:published", None, NS)     # already RFC 3339
        watch = f"https://www.youtube.com/watch?v={vid}"
        g = e.find("m:group", NS)
        tnode = g.find("m:thumbnail", NS) if g is not None else None
        thumb = (thumb_src(vid, tnode.get("url") or "", asset_dir, cap)
                 if tnode is not None else "")
        desc = g.findtext("m:description", "", NS) if g is not None else ""
        if TRIM:
            desc = trim_description(desc)

        content = (
            f'<p><a href="{html.escape(watch)}">'
            f'<img src="{html.escape(thumb)}" alt="{html.escape(title)}"></a></p>'
            + desc_html(desc)
        )
        items.append({
            # Stable per-video dedup key; the Atom <id> fallback keeps entries
            # without a yt:videoId from all hashing the same bare watch URL.
            "guid": fnv1a32(vid or eid or watch),
            "title": title,
            "content": content,
            "link": watch,
            "published": pub,
        })
    return items


def run_ingest(req):
    got = fetch_feed(req)
    if got is None:
        return {"not_modified": True}
    body, etag, last_modified = got
    asset_dir = req.get("asset_dir") or ""
    # srr's --max-asset-size cap, sent per request as max_asset_size (bytes);
    # 0 = no cap. Honored at download time, per the external-ingest contract.
    cap = int(req.get("max_asset_size") or 0)
    return {
        "items": build_items(body, asset_dir, cap),
        "etag": etag,
        "last_modified": last_modified,
    }


CLI_PARAMS = {"--etag": "etag", "--last-modified": "last_modified",
              "--asset-dir": "asset_dir", "--max-asset-size": "max_asset_size"}


def request_from_argv(argv):
    """CLI parameters -> the same request dict srr sends as JSON on stdin."""
    req, i = {}, 0
    while i < len(argv):
        a = argv[i]
        if a in CLI_PARAMS:
            if i + 1 >= len(argv):
                sys.exit(f"srr-youtube: {a} needs a value")
            req[CLI_PARAMS[a]] = argv[i + 1]
            i += 2
        elif a.startswith("-"):
            sys.exit(f"srr-youtube: unknown option {a!r} (see --help)")
        elif "url" in req:
            sys.exit(f"srr-youtube: more than one feed URL given "
                     f"({req['url']!r}, {a!r})")
        else:
            req["url"] = a
            i += 1
    if "url" not in req:
        sys.exit("srr-youtube: missing feed URL (see --help)")
    if "max_asset_size" in req:
        try:
            req["max_asset_size"] = int(req["max_asset_size"])
        except ValueError:
            sys.exit(f"srr-youtube: --max-asset-size must be a byte count, "
                     f"got {req['max_asset_size']!r}")
    return req


def cmd_ingest(req=None):
    # req is built from CLI parameters (manual run) or, when None, read as the
    # JSON request srr writes to stdin (the SRR external-ingest contract).
    pretty = req is not None
    if req is None:
        try:
            req = json.load(sys.stdin)
        except json.JSONDecodeError as e:
            sys.exit(f"srr-youtube: could not parse request on stdin: {e}")
    try:
        result = run_ingest(req)
    except urllib.error.URLError as e:
        sys.exit(f"srr-youtube: feed fetch failed: {e}")
    except ET.ParseError as e:
        sys.exit(f"srr-youtube: feed is not valid XML: {e}")
    if pretty:
        # manual run: readable for a human, not byte-compatible with srr's
        json.dump(result, sys.stdout, indent=2, ensure_ascii=False)
        print()
    else:
        json.dump(result, sys.stdout)


def main():
    global SELFHOST, TRIM
    argv = sys.argv[1:]
    SELFHOST = "--selfhost" in argv
    TRIM = "--trim" in argv
    argv = [a for a in argv if a not in ("--selfhost", "--trim")]
    if argv and argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    if argv and argv[0] in ("version", "--version", "-V"):
        print("srr-youtube", VERSION)
        return
    cmd_ingest(request_from_argv(argv) if argv else None)


if __name__ == "__main__":
    main()
