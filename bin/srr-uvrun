#!/bin/sh
# srr-uvrun — shebang interpreter for the toolbox's Python scripts:
#
#     #!/usr/bin/env srr-uvrun
#
# Locates the repo from its own resolved path and execs the target script in
# the repo's uv project venv (pyproject.toml + uv.lock), so the checkout can
# live anywhere. This indirection exists because a shebang can't be
# script-relative: a relative --project resolves against the INVOKER's cwd —
# measured to silently fall back to system python, or silently adopt an
# unrelated project's venv when the cwd happens to be inside one.
#
# Needs to be reachable from PATH — e.g. via a symlink in a PATH dir — which
# everything here already requires anyway: srr resolves ingest strategies by
# bare name the same way. readlink -f below sees through any symlink, so the
# repo is located from the REAL bin/. A missing entry fails loudly ("env:
# 'srr-uvrun': No such file or directory"), never silently wrong.
here="$(dirname "$(readlink -f "$0")")"
exec uv run --project "$(dirname "$here")" --script "$@"
