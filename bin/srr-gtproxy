#!/usr/bin/env srr-uvrun
"""drr external pipeline step: replace a teaser with the item's whole page,
read through Google Translate's website proxy, for drr to extract.

drr execs any non-#builtin `pipe` entry once per item, writing the item JSON
to stdin and reading the (possibly modified) item JSON back from stdout:

    {guid, title, content, link, published, lang?, raw, drop?}

WHY A PROXY
-----------
Some sites serve a teaser-only feed and put their pages behind a bot check
that refuses drr's own HTTP client from every address it has (`#readability`
then keeps the teaser). Google Translate's website proxy fetches a page from
Google's servers, which those checks let through, and answers with the page's
own text: the translation runs in the visitor's browser, from a script the
proxy adds, so the HTML it returns is the original. This step asks the proxy
for the item's link,

    https://www.example.com/a/b?x=1
 -> https://www-example-com.translate.goog/a/b?x=1&_x_tr_sl=auto&_x_tr_tl=en&_x_tr_hl=en

(the host's '-' doubled, then its '.' turned into '-'), takes out what the
proxy added (its metas, its scripts and the font its toolbar uses), turns every
URL it rewrote back into the original (`translate.google.com/website?...&u=<url>`
to <url>, `<host>.translate.goog` to <host> without its `_x_tr_*` parameters)
and makes the whole page the item's content. Only https links are read.

The step only fetches: picking the article out of the page is drr's
`#readability source=content`, and removing what it keeps but should not is
`#strip`, so a feed opts in with

    drr feed upd <id> -p srr-gtproxy \
        -p '#readability source=content selector="article.post-body"' \
        -p '#strip select=".gallery .more"' -p '#default'

(without selector=, #readability's heuristic picks the article). The proxy is
a free Google service with no contract: it can change or start refusing, and
the site can start refusing it. Either way the step emits nothing, the teaser
stays, and #readability notes that its selector matched nothing.

ON THE FETCH PATH THIS STEP NEVER EXITS NON-ZERO. drr drops an item whose
pipe step fails and keeps its guid, so the article would be gone for good —
worse than keeping the teaser. Every failure (the proxy unreachable, a non-200
answer, a page with no text, a typo'd flag in the feed's `pipe`) is reported
on stderr, and the step emits nothing, which drr reads as "leave the item
unchanged". --help/--version print on STDERR for the same reason: stdout is the
protocol channel. Run the step manually (a URL argument) to have failures
reported with a non-zero exit. A busy proxy (HTTP 429 or 503: it rate-limits
an address that asks too often) is asked again after 15, 45 and 90 s, or after
its Retry-After when that is longer (up to 90 s), well inside drr's
cmd-timeout.

KNOBS
-----
  --timeout <s>      the proxy request's timeout (default 30)
  --ua <string>      the User-Agent sent to the proxy (default a desktop
                     Chrome's)

MANUAL RUNS (a URL instead of stdin)
------------------------------------
    srr-gtproxy https://www.example.com/a/b

builds the item drr would send for that link and pretty-prints the result,
the whole page in its content. To see what a feed would store, preview the
whole pipe: drr preview <feed url> -p srr-gtproxy -p '#readability ...' ...
"""
import json
import sys
import time
import urllib.error
import urllib.parse
import urllib.request

from bs4 import BeautifulSoup

VERSION = "2.1"

PROXY_DOMAIN = "translate.goog"
# sl=auto/tl=en is accepted for a page in any language (sl == tl is a 400)
# and changes nothing in the returned HTML: the text is translated in the
# browser, never by the proxy.
PROXY_PARAMS = (("_x_tr_sl", "auto"), ("_x_tr_tl", "en"), ("_x_tr_hl", "en"))
DEFAULT_TIMEOUT = 30.0
DEFAULT_UA = ("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 "
              "(KHTML, like Gecko) Chrome/154.0.0.0 Safari/537.36")
MAX_BODY = 8 << 20   # the same cap as drr's #readability fetch

# A busy proxy (429, or 503) is asked again after each of these waits, or
# after its Retry-After when that is longer, up to RETRY_AFTER_MAX. The whole
# run stays minutes under drr's cmd-timeout, past which drr would drop the
# item for good; a proxy still busy at the end leaves the teaser.
RETRY_STATUS = (429, 503)
RETRY_WAITS = (15, 45, 90)
RETRY_AFTER_MAX = 90
sleep = time.sleep  # the tests' seam

# Attributes holding a srcset list; any other attribute holding a proxy URL
# is one URL.
SRCSET_ATTRS = ("srcset", "data-srcset", "imagesrcset")

# What the proxy adds to a page, as measured on live answers (2026-10): two
# X-Translated-* metas, a robots "none" meta, its scripts from gstatic's
# translate_http, an inline one that starts its TranslateService, one with
# the id below, and the Material Symbols font its toolbar draws with. The
# page's own <base href> (the original URL) is kept.
PROXY_SCRIPT_PREFIX = "https://www.gstatic.com/_/translate_http/"
PROXY_SCRIPT_ID = "google-translate-element-script"
PROXY_INLINE_MARK = "google.translate.TranslateService"
PROXY_FONT_PREFIX = "https://fonts.googleapis.com/css2?family=Material+Symbols"


def log(*a):
    print("srr-gtproxy:", *a, file=sys.stderr)


def fnv1a32(s: str) -> int:
    h = 0x811C9DC5
    for b in s.encode("utf-8"):
        h = ((h ^ b) * 0x01000193) & 0xFFFFFFFF
    return h


def encode_host(host: str) -> str:
    return host.replace("-", "--").replace(".", "-")


def decode_host(label: str) -> str:
    # Read left to right: "--" is a hyphen, a lone "-" a dot.
    out, i = [], 0
    while i < len(label):
        if label.startswith("--", i):
            out.append("-")
            i += 2
        elif label[i] == "-":
            out.append(".")
            i += 1
        else:
            out.append(label[i])
            i += 1
    return "".join(out)


def proxy_url(link: str):
    """The proxy's URL for an https link, or None when it cannot be proxied."""
    u = urllib.parse.urlsplit(link)
    if u.scheme != "https" or not u.hostname or u.port is not None:
        return None
    q = urllib.parse.parse_qsl(u.query, keep_blank_values=True)
    q += list(PROXY_PARAMS)
    return urllib.parse.urlunsplit((
        "https", encode_host(u.hostname) + "." + PROXY_DOMAIN,
        u.path or "/", urllib.parse.urlencode(q), ""))


def unwrap_url(url: str) -> str:
    """The original URL behind a proxy-rewritten one; anything else as is."""
    s = url.strip()
    try:
        u = urllib.parse.urlsplit(s)
    except ValueError:
        return url
    host = (u.hostname or "").lower()
    if host == "translate.google.com" and u.path in ("/website", "/translate"):
        target = dict(urllib.parse.parse_qsl(u.query)).get("u")
        return target if target else url
    suffix = "." + PROXY_DOMAIN
    if host.endswith(suffix) and len(host) > len(suffix):
        q = [(k, v) for k, v in urllib.parse.parse_qsl(u.query, keep_blank_values=True)
             if not k.startswith("_x_tr_")]
        return urllib.parse.urlunsplit((
            u.scheme or "https", decode_host(host[:-len(suffix)]), u.path,
            urllib.parse.urlencode(q), u.fragment))
    return url


def unwrap_srcset(value: str) -> str:
    parts = []
    for cand in value.split(","):
        bits = cand.strip().split(None, 1)
        if not bits:
            continue
        bits[0] = unwrap_url(bits[0])
        parts.append(" ".join(bits))
    return ", ".join(parts)


def proxy_added(tag) -> bool:
    """Whether tag is one of the proxy's additions (PROXY_*)."""
    if tag.name == "script":
        src = tag.get("src") or ""
        return (tag.get("id") == PROXY_SCRIPT_ID or src.startswith(PROXY_SCRIPT_PREFIX)
                or (not src and PROXY_INLINE_MARK in (tag.string or "")))
    if tag.name == "meta":
        equiv = (tag.get("http-equiv") or "").lower()
        robots = ((tag.get("name") or "").lower() == "robots"
                  and (tag.get("content") or "").strip().lower() == "none")
        return equiv.startswith("x-translated-") or robots
    if tag.name == "link":
        return (tag.get("href") or "").startswith(PROXY_FONT_PREFIX)
    return False


def has_proxy_url(value: str) -> bool:
    return PROXY_DOMAIN in value or "translate.google.com" in value


def clean(page, charset=None):
    """The page as the site serves it (bytes in `charset`, else detected; or
    str): the proxy's additions removed and its URLs turned back into the
    originals. None when its body has no text."""
    if isinstance(page, bytes) and charset:
        soup = BeautifulSoup(page, "html5lib", from_encoding=charset)
    else:
        soup = BeautifulSoup(page, "html5lib")
    for tag in [t for t in soup.find_all(["script", "meta", "link"]) if proxy_added(t)]:
        tag.decompose()
    for tag in soup.find_all(True):
        for a, v in tag.attrs.items():
            if isinstance(v, str) and has_proxy_url(v):
                tag[a] = unwrap_srcset(v) if a in SRCSET_ATTRS else unwrap_url(v)
    if soup.body is None or not soup.body.get_text().strip():
        return None
    return str(soup)


def fetch(url: str, cfg: dict):
    """(body bytes, the charset the response declares or None), asking a
    busy proxy again (RETRY_*)."""
    for wait in RETRY_WAITS + (None,):
        try:
            return fetch_once(url, cfg)
        except urllib.error.HTTPError as e:
            e.close()
            if e.code not in RETRY_STATUS or wait is None:
                raise
            pause = max(wait, min(retry_after(e.headers.get("Retry-After")), RETRY_AFTER_MAX))
            log("HTTP %d from the proxy, asking again in %ds" % (e.code, pause))
            sleep(pause)


def retry_after(value) -> int:
    """A Retry-After in seconds; 0 for none or an HTTP date."""
    try:
        return max(0, int((value or "").strip()))
    except ValueError:
        return 0


def fetch_once(url: str, cfg: dict):
    req = urllib.request.Request(url, headers={
        "User-Agent": cfg["ua"],
        "Accept": "text/html,application/xhtml+xml",
        "Accept-Language": "en",
    })
    with urllib.request.urlopen(req, timeout=cfg["timeout"]) as r:
        if r.status != 200:
            raise OSError("HTTP %d" % r.status)
        body = r.read(MAX_BODY + 1)
        charset = r.headers.get_content_charset()
    if len(body) > MAX_BODY:
        raise OSError("page over %d bytes" % MAX_BODY)
    return body, charset


def run_item(item: dict, cfg: dict):
    """The item with its content replaced, or None to leave it unchanged.
    Raises only for a manual run to report; the caller decides."""
    link = item.get("link") or ""
    url = proxy_url(link)
    if url is None:
        raise ValueError("not an https link without a port: %r" % link)
    body, charset = fetch(url, cfg)
    content = clean(body, charset)
    if content is None:
        raise ValueError("the proxy's page has no text: %s" % link)
    item["content"] = content
    return item


def parse_argv(argv):
    """(cfg, url, errors): url is the manual run's positional, else None."""
    cfg = {"timeout": DEFAULT_TIMEOUT, "ua": DEFAULT_UA}
    errors, urls = [], []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("--timeout", "--ua"):
            if i + 1 >= len(argv):
                errors.append("%s needs a value" % a)
                break
            cfg[a[2:]] = argv[i + 1]
            i += 2
        elif a.startswith("-"):
            errors.append("unknown option %r (see --help)" % a)
            i += 1
        elif a.startswith(("https://", "http://")):
            urls.append(a)
            i += 1
        else:
            # Not a URL, so no manual run: a value of an unknown flag (an old
            # --selector's, say) must leave the step on the fetch path, where
            # a failure passes the item through instead of dropping it.
            errors.append("unexpected argument %r (a manual run takes an http(s) URL)" % a)
            i += 1
    try:
        cfg["timeout"] = float(cfg["timeout"])
        if cfg["timeout"] <= 0:
            raise ValueError
    except (TypeError, ValueError):
        errors.append("--timeout must be a positive number, got %r" % cfg["timeout"])
        cfg["timeout"] = DEFAULT_TIMEOUT
    if len(urls) > 1:
        errors.append("more than one URL (%s)" % ", ".join(repr(u) for u in urls))
    return cfg, (urls[0] if urls else None), errors


def main():
    argv = sys.argv[1:]
    if argv and argv[0] in ("-h", "--help", "help"):
        print(__doc__, file=sys.stderr)
        return
    if argv and argv[0] in ("version", "--version", "-V"):
        print("srr-gtproxy", VERSION, file=sys.stderr)
        return
    cfg, url, errors = parse_argv(argv)
    if url is not None:
        # A manual run: the item drr would send for this link, failures loud.
        if errors:
            sys.exit("srr-gtproxy: " + errors[0])
        item = {"guid": fnv1a32(url), "title": "", "content": "", "link": url,
                "published": None}
        try:
            result = run_item(item, cfg)
        except Exception as e:
            sys.exit("srr-gtproxy: %s" % e)
        json.dump(result, sys.stdout, indent=2, ensure_ascii=False)
        print()
        return
    if errors:
        log("%s: passing items through unchanged" % errors[0])
        return
    try:
        sys.stdin.reconfigure(encoding="utf-8", errors="strict")
        item = json.load(sys.stdin)
    except (ValueError, RecursionError) as e:
        log("could not parse item on stdin (%s): emitting nothing" % e)
        return
    try:
        result = run_item(item, cfg)
        # `raw` is restored by drr over whatever comes back: never echo it.
        result.pop("raw", None)
        out = json.dumps(result, allow_nan=False)
    except Exception as e:
        log("%s: keeping the item as it is" % e)
        return
    sys.stdout.write(out)


if __name__ == "__main__":
    main()
